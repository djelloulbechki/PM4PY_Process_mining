# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Redis (inside docker-compose)
REDIS_URL=redis://redis:6379/0

# Storage buckets (create as private in Supabase)
DATASETS_BUCKET=datasets
ARTIFACTS_BUCKET=artifacts

# Limits
MAX_PREVIEW_BYTES=1048576
MAX_UPLOAD_BYTES=524288000
DEFAULT_MAX_ROWS=100000
ARTIFACT_SIGNED_URL_TTL=3600

# CORS – comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,https://app.example.com

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Fernet key for encrypting connector API credentials. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=
