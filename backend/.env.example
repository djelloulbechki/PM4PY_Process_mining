# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Redis (inside docker-compose)
REDIS_URL=redis://redis:6379/0

# Storage buckets (create as private in Supabase)
DATASETS_BUCKET=datasets
ARTIFACTS_BUCKET=artifacts

# Limits
MAX_PREVIEW_BYTES=1048576
MAX_UPLOAD_BYTES=524288000
DEFAULT_MAX_ROWS=100000
ARTIFACT_SIGNED_URL_TTL=3600

# CORS – comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,https://app.example.com
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Fernet key for encrypting connector API credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────
# Stripe Billing (Pay-As-You-Go)
# ──────────────────────────────────────────────────────────────
# ⚠️  NEVER commit real keys. Use placeholders only in this file.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
FRONTEND_URL=http://localhost:3000

# Stripe Product IDs (for reference)
STRIPE_PRODUCT_STANDARD=prod_REPLACE_WITH_STANDARD_PRODUCT_ID
STRIPE_PRODUCT_PRO=prod_REPLACE_WITH_PRO_PRODUCT_ID
STRIPE_PRODUCT_SCALE=prod_REPLACE_WITH_SCALE_PRODUCT_ID

# Stripe Price IDs (ONE-TIME payments)
STRIPE_PRICE_STANDARD=price_REPLACE_WITH_STANDARD_PRICE_ID
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_PRICE_ID
STRIPE_PRICE_SCALE=price_REPLACE_WITH_SCALE_PRICE_ID
